# JWT Secret
JWT_SECRET=change-me-to-random-string

# Database
DB_TYPE=sqlite
# DATABASE_URL=postgres://realm:password@localhost:5432/realm_flow?sslmode=disable

# PostgreSQL (if using postgres)
POSTGRES_DB=realm_flow
POSTGRES_USER=realm
POSTGRES_PASSWORD=change-me

# Telegram Bot
TG_BOT_TOKEN=your-bot-token

# Server Ports
BACKEND_PORT=6365
FRONTEND_PORT=6366

# Agent Config
PANEL_URL=http://localhost:6365
API_KEY=

# Notification Settings
NOTIFICATION_ENABLED=true
NOTIFICATION_INTERVAL=60
