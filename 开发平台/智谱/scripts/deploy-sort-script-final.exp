#!/usr/bin/expect -f

set timeout 120
set host "185.213.175.124"
set port "22"
set user "root"
set password "Cej1SRY4wgl$"

log_user 1

spawn ssh -p $port -o StrictHostKeyChecking=no $user@$host

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "#" {
        send "rm -f /root/sort_servers.py\r"
        expect "#"
        send "echo '#!/usr/bin/env python3' > /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        expect "#"
        send "echo 'import sqlite3' >> /root/sort_servers.py\r"
        expect "#"
        send "echo 'import re' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo 'def is_chinese(text):' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    return any(chr(0x4e00) <= char <= chr(0x9fff) for char in text)' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo 'def sort_key(name):' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    if is_chinese(name):' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '        return (1, name)' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    else:' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '        return (0, name)' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo 'def main():' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    db_path = /opt/dstatus/data/db.db' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    conn = sqlite3.connect(db_path)' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    cursor = conn.cursor()' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo '    cursor.execute(\"SELECT sid, name FROM servers WHERE deleted_at IS NULL\")' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    servers = cursor.fetchall()' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo '    servers.sort(key=lambda x: sort_key(x[1]))' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo '    for index, (sid, name) in enumerate(servers):' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '        cursor.execute(\"UPDATE servers SET display_index = ? WHERE sid = ?\", (index, sid))' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '        print(\"{}: {}\".format(index, name))' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo '    conn.commit()' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    conn.close()' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo '    print(\"\\\\n排序完成！\")' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '' >> /root/sort_servers.py\r"
        send "echo 'if __name__ == \"__main__\":' >> /root/sort_servers.py\r"
        expect "#"
        send "echo '    main()' >> /root/sort_servers.py\r"
        expect "#"
        send "chmod +x /root/sort_servers.py\r"
        expect "#"
        send "python3 /root/sort_servers.py\r"
        expect "#"
        send "echo '=== Verifying result ==='\r"
        expect "#"
        send "sqlite3 /opt/dstatus/data/db.db \"SELECT sid, name, display_index FROM servers WHERE deleted_at IS NULL ORDER BY display_index;\"\r"
        expect "#"
        send "exit\r"
    }
}

expect eof
