#!/usr/bin/expect -f

set timeout 30
set host "185.213.175.124"
set port "22"
set user "root"
set password "Cej1SRY4wgl$"

log_user 1

spawn ssh -p $port -o StrictHostKeyChecking=no $user@$host

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "#" {
        send "uname -a\r"
        expect "#"
        send "whoami\r"
        expect "#"
        send "hostname\r"
        expect "#"
        send "free -h\r"
        expect "#"
        send "df -h\r"
        expect "#"
        send "echo '=== Server connection successful ==='\r"
        expect "#"
        send "exit\r"
    }
}

expect eof
